# ─────────────────────────────────────────────────────────────────────────────
# CODERSWURLD INVENTORY — environment
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local pgAdmin/Postgres. Create the database first:
#   CREATE DATABASE coderswurld;
# Then put the password for your `postgres` role below.
# If your password contains @ : / ? # or %, URL-encode it (@ -> %40).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/coderswurld?schema=public"

# On Supabase (see DEPLOY.md):
#   DATABASE_URL = the "Transaction pooler" string (port 6543), used by the app.
#   DIRECT_URL   = the "Session pooler" string (port 5432), used only by
#                  `npx prisma migrate deploy`. Leave empty when working locally.
DIRECT_URL=""
# TLS to the database: empty = automatic (on for hosted, off for localhost).
# "verify" also checks the certificate (put Supabase's CA in DATABASE_CA_CERT).
DATABASE_SSL=""
DATABASE_CA_CERT=""
# Connections per server. Empty = 3 on Vercel, 10 elsewhere.
DATABASE_POOL_SIZE=""

# ── Session signing ──────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing this invalidates every logged-in session.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ── Platform operator (you) ──────────────────────────────────────────────────
# Seeded as the universal admin who approves organizations.
PLATFORM_ADMIN_NAME="Coderswurld"
PLATFORM_ADMIN_EMAIL="admin@coderswurld.com"
PLATFORM_ADMIN_PASSWORD="ChangeThisNow!2026"

# Where landing-page plan requests are emailed. Defaults to PLATFORM_ADMIN_EMAIL.
SALES_NOTIFICATION_EMAIL=""

# ── Your bank account for plan payments ──────────────────────────────────────
# When a business picks a plan on the landing page, these are emailed to them
# straight away with their reference and an "I've made the payment" button.
# Leave any of them empty and they're told you'll send the details instead.
PAYMENT_BANK_NAME="FCMB"
PAYMENT_ACCOUNT_NAME=""
PAYMENT_ACCOUNT_NUMBER=""

# Where customers' replies go (emails are sent from MAIL_FROM, a no-reply
# address). Defaults to SUPPORT_EMAIL, then SALES_NOTIFICATION_EMAIL.
MAIL_REPLY_TO=""

# ── Email delivery (Resend) ──────────────────────────────────────────────────
# Get an API key at resend.com → API Keys. MAIL_FROM must use a domain you have
# verified in Resend (Domains). Until you verify one, Resend only lets you send
# from onboarding@resend.dev, and only to your own Resend sign-up email.
# Leave RESEND_API_KEY empty in development: emails are printed in the terminal.
RESEND_API_KEY=""
MAIL_FROM="Coderswurld Inventory <no-reply@yourdomain.com>"

# ── Email delivery (SMTP, optional fallback, used only if RESEND_API_KEY is empty)
# Used for plan-request alerts, provisioning credentials and daily reports.
# Leave SMTP_HOST empty in development: emails are logged to the console
# instead of being sent, so nothing breaks without credentials.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Coderswurld Inventory <no-reply@coderswurld.com>"

# ── WhatsApp (Meta WhatsApp Business Cloud API) ──────────────────────────────
# Optional. Without these, WhatsApp report delivery degrades to a logged
# no-op and the UI shows the channel as unconfigured rather than failing.
# From developers.facebook.com -> your app -> WhatsApp -> API Setup.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# Shared secret for /api/cron/* endpoints (daily reports, expiry sweep).
# Call them with:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET="change-me-too"

# ── File storage (supplier receipts) ─────────────────────────────────────────
# Where uploaded receipts are kept. Defaults to a `storage` folder next to the
# app, which is fine on your own PC or a VPS with a disk. On a host with no
# permanent disk (Vercel, most containers) this must become S3 / Cloudflare R2:
# only lib/storage.ts needs to change. BACK THIS FOLDER UP — it is customer data.
STORAGE_DIR=""

# On Vercel there is no permanent disk: receipts go to Supabase Storage instead.
# Supabase -> Project Settings -> API: Project URL and the service_role key.
# Create a PRIVATE bucket called "receipts" (Storage -> New bucket).
# The service_role key is a master key: only ever put it in Vercel's
# environment variables, never in code or anything starting NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="receipts"

# ── App ──────────────────────────────────────────────────────────────────────
# Absolute base URL, used in emails, receipts, the sitemap and share cards.
# On Vercel set it to your real domain, e.g. https://coderswurld.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Google Search Console ────────────────────────────────────────────────────
# Optional. Search Console -> Add property -> URL prefix -> "HTML tag": paste
# only the content="..." value here. (Or verify by DNS and leave this empty.)
GOOGLE_SITE_VERIFICATION=""

# ── Support contacts ─────────────────────────────────────────────────────────
# Shown to locked-out customers on /locked so they can pay and get back in.
SUPPORT_EMAIL="support@coderswurld.com"
SUPPORT_PHONE="+2348000000000"
SUPPORT_WHATSAPP="+2348000000000"
